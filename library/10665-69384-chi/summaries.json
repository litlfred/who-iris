      "source_hash": "e48ec879c03a873c5a8bf03f4d36ada96057d7fcbe16fae238cb517d385ca717",
      "narrative": [
        {
          "text": "The Chinese copyright and disclaimer page of the 2006 HPV vaccine guidance, with WHO Press ordering and permissions details; the extracted text is fragmented.",
