    {
      "id": "library/10665-365881/blocks/prose-sec-000",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Introduction",
      "pageStart": 8,
      "pageEnd": 32,
      "target": "../sections/sec-000-introduction.md",
      "narrative": null,
      "content": "This is the third report in the series documenting \nthe work of the World Health Organization (WHO) \nin managing and responding to the coronavirus \ndisease 2019 (COVID-19) pandemic in Somalia. \nThe first of these reports was published in 2020 to \nmark six months from the start of the pandemic in \nSomalia, while the second report was published in \n2021 to mark one year of the COVID-19 pandemic in \nthe country1.  \nThis report marks the second year anniversary \nof COVID-19 pandemic in Somalia. It covers the \nactivities undertaken and achievements made \nby WHO, together with national and subnation",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Introduces the third WHO report on its COVID-19 response in Somalia, covering March 2020 to March 2022 and organised in line with WHO's strategic preparedness and response plan. Section 1 describes how WHO helped national and state health authorities lead the response from the first case in March 2020, using incident management support teams and leading UN coordination bodies. Later sections, based on the headings, cover building essential public health functions, rolling out COVID-19 vaccines and maintaining essential health services. The section ends with a story on infection prevention and control training and figures on treatment centres, oxygen supplies, protective equipment and kits provided with WHO support.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
    },
