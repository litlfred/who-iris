    {
      "id": "library/10665-365881/blocks/prose-sec-001",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Promoting science, evidence and knowledge: translating research into actions on health",
      "pageStart": 32,
      "pageEnd": 42,
      "target": "../sections/sec-001-promoting-science-evidence-and-knowledge-transla.md",
      "narrative": null,
      "content": "knowledge: translating research \ninto actions on health \nThe WHO country office continued to support the \nuse of science, data and evidence in public health \ndecisions-making for managing COVID-19 as well \nas to inform implementation and operational \nresponse strategies. The use of data for risk \nassessment and intelligence-gathering allowed \nthe country office to promote science-based \nstandards and tailor and target health interventions \nthat have proved to be effective and efficient in a \nfragile setting. A number of original research and \nsystematic reviews were conducted by the country \no",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Describes how WHO Somalia used data, research and digital tools such as EWARN, dashboards, a community health worker app, chatbots and CommCare vaccine registration covering over 1.3 million people to guide its COVID-19 response. It reports on research studies, publications and information notes produced, which built local research capacity. The final section draws lessons for an inclusive recovery, arguing for investment in primary health care, essential public health functions and the health workforce to build resilience and progress towards universal health coverage, followed by acknowledgements of donors.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
    },
