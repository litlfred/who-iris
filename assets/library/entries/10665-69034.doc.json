    {
      "id": "sec-006-c-where-to-conduct-a-dqs",
      "number": null,
      "title": "C. Where to conduct a DQS?",
      "level": 1,
      "pageStart": 37,
      "pageEnd": 40,
      "labelStart": "27",
      "labelEnd": "30",
      "words": 851,
      "summary": {
        "text": "Advises visiting at least three and at most six health units per district, since precision gains level off beyond six, and stresses that discussion of findings matters more than exact figures. It discusses how to select districts and health units and notes that results from one district cannot be extrapolated, though common problems can be shared through feedback.",
        "status": "draft"
      },
