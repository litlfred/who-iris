<?xml version="1.0" encoding="UTF-8"?>
<!--
  who-iris — Publish an IRIS CDN signing key (offline).

  Source of truth: this file. Open it in bpmn.io, Camunda Modeler, or any other
  BPMN 2.0 tool. Implements the IRIS CDN Exporter (issue litlfred/who-iris#100);
  the prose is docs/iris-cdn-export.md, the skills are skills/iris-cdn-*.md and
  the code is scripts/iris-cdn/.

  Owner's choices, 2026-10-30: the initial load carries metadata AND the PDFs;
  changes are read from the DSpace REST API only; exports live on Cloudflare (a git
  repository on Cloudflare Artifacts, NOT GitHub, plus R2 behind the CDN), and
  GitHub Pages of who-iris only previews the exported site; keys are published as verificationMethods of a
  did:web DID document (no GDHCN trust list is assumed). Standing requirement:
  content that has not changed is not rewritten, re-uploaded or re-signed.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/v0/processes/ns#"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/v0/processes/ns#"
                  id="Definitions_IrisCdnKeyPublication"
                  targetNamespace="https://litlfred.github.io/who-iris/processes">
  <bpmn:import namespace="https://litlfred.github.io/bootstrap/v0/processes/ns#" location="https://litlfred.github.io/bootstrap/v0/processes/ns.jsonld" importType="http://www.w3.org/ns/json-ld"/>
  <bpmn:resource id="key-custodian" name="Key custodian"/>
  <bpmn:resource id="who-signing-authority" name="WHO signing authority"/>
  <bpmn:resource id="cloudflare-r2-cdn" name="Cloudflare R2 and CDN"/>
  <bpmn:resource id="github-environment" name="GitHub environment"/>
  <bpmn:process id="Process_IrisCdnKeyPublication" name="Publish an IRIS CDN signing key (offline)" isExecutable="false">
    <bpmn:documentation>How the exporter's signing key comes to exist and to be trusted. Offline by the owner's rule (2026-10-30: &quot;publication of subordinate key is an offline process&quot;). The trust chain rides in the DID document as publicKeyJwk.x5c (RFC 7517 §4.7), ending at a certificate WHO's signing key issued. Also the rotation process: run it again with a new fragment, then retire the old key from assertionMethod.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_IrisCdnKeyPublication">
      <bpmn:lane id="Lane_KeyOwner" name="Key custodian (offline)" partitionElementRef="key-custodian">
        <bpmn:documentation>A person, on a machine that is not CI. Generates the key and never lets the private half touch git, a log or a bean.</bpmn:documentation>
        <bpmn:flowNodeRef>Start_KeyNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateKey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Csr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildDid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckChain</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WhoSigning" name="WHO signing authority" partitionElementRef="who-signing-authority">
        <bpmn:documentation>Holds the key in WHO's signing DID (did:web:raw.githubusercontent.com:WorldHealthOrganization:tng-participants-prod:main:WHO:signing:DID). Issues the certificate that makes our key subordinate.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_Issue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CfStore" name="Cloudflare R2 + CDN" partitionElementRef="cloudflare-r2-cdn">
        <bpmn:documentation>Object storage behind the CDN. Every object is named by its SHA-256 and served with an immutable cache policy; an object already present is never written again. Also serves did.json.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_PublishDid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GitHubEnv" name="GitHub environment iris-cdn-release" partitionElementRef="github-environment">
        <bpmn:documentation>Holds the private JWK as an environment secret, readable only by jobs on main.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_StoreSecret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KeyLive</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_KeyNeeded" name="A signing key is&#10;needed (or rotation due)"/>
    <bpmn:task id="Task_GenerateKey" name="Generate a P-256 key&#10;pair, offline">
      <bpmn:extensionElements><bootstrap.processes:skill ref="iris-cdn-signing"/></bpmn:extensionElements>
    </bpmn:task>
    <bpmn:task id="Task_Csr" name="Make a certificate&#10;signing request">
      <bpmn:extensionElements><bootstrap.processes:skill ref="iris-cdn-signing"/></bpmn:extensionElements>
    </bpmn:task>
    <bpmn:task id="Task_Issue" name="Issue the subordinate&#10;certificate">
      <bpmn:documentation>Signed by the key in WHO's signing DID. Out of band; this repository never holds WHO's private key.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_BuildDid" name="Build did.json with&#10;publicKeyJwk.x5c">
      <bpmn:documentation>scripts/iris-cdn/signing.ts didDocument. x5c is leaf first; the new key is added to assertionMethod; retired keys stay in verificationMethod only.</bpmn:documentation>
      <bpmn:extensionElements><bootstrap.processes:skill ref="iris-cdn-signing"/></bpmn:extensionElements>
    </bpmn:task>
    <bpmn:task id="Task_CheckChain" name="Check the chain ends&#10;at WHO's key">
      <bpmn:documentation>signing.ts chainProblem against WHO's published JWK, before anything is published.</bpmn:documentation>
      <bpmn:extensionElements><bootstrap.processes:skill ref="iris-cdn-signing"/></bpmn:extensionElements>
    </bpmn:task>
    <bpmn:task id="Task_PublishDid" name="Publish did.json&#10;on the CDN domain"/>
    <bpmn:task id="Task_StoreSecret" name="Store the private JWK&#10;as IRIS_CDN_SIGNING_JWK"/>
    <bpmn:endEvent id="End_KeyLive" name="Key live; next&#10;release signs with it"/>
    <bpmn:sequenceFlow id="K1" sourceRef="Start_KeyNeeded" targetRef="Task_GenerateKey"/>
    <bpmn:sequenceFlow id="K2" sourceRef="Task_GenerateKey" targetRef="Task_Csr"/>
    <bpmn:sequenceFlow id="K3" sourceRef="Task_Csr" targetRef="Task_Issue"/>
    <bpmn:sequenceFlow id="K4" sourceRef="Task_Issue" targetRef="Task_BuildDid"/>
    <bpmn:sequenceFlow id="K5" sourceRef="Task_BuildDid" targetRef="Task_CheckChain"/>
    <bpmn:sequenceFlow id="K6" sourceRef="Task_CheckChain" targetRef="Task_PublishDid"/>
    <bpmn:sequenceFlow id="K7" sourceRef="Task_PublishDid" targetRef="Task_StoreSecret"/>
    <bpmn:sequenceFlow id="K8" sourceRef="Task_StoreSecret" targetRef="End_KeyLive"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_IrisCdnKeyPublication">
    <bpmndi:BPMNPlane id="Plane_IrisCdnKeyPublication" bpmnElement="Process_IrisCdnKeyPublication">
      <bpmndi:BPMNShape id="S_Lane_KeyOwner" bpmnElement="Lane_KeyOwner" isHorizontal="true"><dc:Bounds x="160" y="60" width="1830" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_WhoSigning" bpmnElement="Lane_WhoSigning" isHorizontal="true"><dc:Bounds x="160" y="200" width="1830" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_CfStore" bpmnElement="Lane_CfStore" isHorizontal="true"><dc:Bounds x="160" y="340" width="1830" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_GitHubEnv" bpmnElement="Lane_GitHubEnv" isHorizontal="true"><dc:Bounds x="160" y="480" width="1830" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_KeyNeeded" bpmnElement="Start_KeyNeeded"><dc:Bounds x="297" y="112" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="255" y="152" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_GenerateKey" bpmnElement="Task_GenerateKey"><dc:Bounds x="430" y="90" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Csr" bpmnElement="Task_Csr"><dc:Bounds x="620" y="90" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Issue" bpmnElement="Task_Issue"><dc:Bounds x="810" y="230" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_BuildDid" bpmnElement="Task_BuildDid"><dc:Bounds x="1000" y="90" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_CheckChain" bpmnElement="Task_CheckChain"><dc:Bounds x="1190" y="90" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_PublishDid" bpmnElement="Task_PublishDid"><dc:Bounds x="1380" y="370" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_StoreSecret" bpmnElement="Task_StoreSecret"><dc:Bounds x="1570" y="510" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_KeyLive" bpmnElement="End_KeyLive"><dc:Bounds x="1817" y="532" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1775" y="572" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_K1" bpmnElement="K1"><di:waypoint x="333" y="130"/><di:waypoint x="430" y="130"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_K2" bpmnElement="K2"><di:waypoint x="580" y="130"/><di:waypoint x="620" y="130"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_K3" bpmnElement="K3"><di:waypoint x="770" y="130"/><di:waypoint x="790" y="130"/><di:waypoint x="790" y="270"/><di:waypoint x="810" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_K4" bpmnElement="K4"><di:waypoint x="960" y="270"/><di:waypoint x="980" y="270"/><di:waypoint x="980" y="130"/><di:waypoint x="1000" y="130"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_K5" bpmnElement="K5"><di:waypoint x="1150" y="130"/><di:waypoint x="1190" y="130"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_K6" bpmnElement="K6"><di:waypoint x="1340" y="130"/><di:waypoint x="1360" y="130"/><di:waypoint x="1360" y="410"/><di:waypoint x="1380" y="410"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_K7" bpmnElement="K7"><di:waypoint x="1530" y="410"/><di:waypoint x="1550" y="410"/><di:waypoint x="1550" y="550"/><di:waypoint x="1570" y="550"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_K8" bpmnElement="K8"><di:waypoint x="1720" y="550"/><di:waypoint x="1817" y="550"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
