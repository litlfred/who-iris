  "@graph": [
    {
      "@id": "references/10665-360601",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "Consolidated guidelines on HIV, viral hepatitis and STI prevention, diagnosis, treatment and care for key populations",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2022-07-22",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240052390 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/360601",
      "dcterms:language": "en",
      "dcterms:abstract": "This guideline provides consolidated, evidence-based recommendations for the prevention, diagnosis, treatment and care of HIV, viral hepatitis and sexually transmitted infections (STIs) among key populations. It responds to the disproportionate burden of these infections in groups such as men who have sex with men, sex workers, people who inject drugs, people in prisons and other closed settings, and trans and gender diverse individuals, and to the structural barriers that limit their access to health services. The document aims to support countries in strengthening integrated, people-centred responses to these interconnected epidemics.\n\nDeveloped using WHO guideline standards and the GRADE methodology, the publication brings together existing and new recommendations and organizes them into comprehensive packages of interventions. It addresses enabling factors such as legal and policy environments, stigma, discrimination, violence and community empowerment, alongside essential health interventions including prevention, testing, treatment and harm reduction. The guideline also outlines service delivery approaches, such as community-led services, integration and decentralization, and provides guidance for programme planning, implementation and monitoring. Intended for policy-makers, programme managers and health-care providers, it supports the prioritization of effective, context-appropriate strategies to improve access, coverage and health outcomes for key populations.",
      "dcterms:source": "catalogue/records/10665-360601.dc.json",
      "dcterms:hasVersion": "library/10665-360601"
    },
