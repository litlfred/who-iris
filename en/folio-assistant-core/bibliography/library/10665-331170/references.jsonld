  "@graph": [
    {
      "@id": "references/10665-331170",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "WHO consolidated guidelines on tuberculosis: module 1: prevention: tuberculosis preventive treatment",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2020-02-25",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240001503",
      "dcterms:identifier": "https://iris.who.int/handle/10665/331170",
      "dcterms:language": "en",
      "dcterms:abstract": "This guideline provides updated WHO recommendations for the programmatic management of tuberculosis preventive treatment (TPT) as part of the WHO consolidated guidelines on tuberculosis. It focuses on the prevention of active tuberculosis among people at increased risk of disease progression, particularly people living with HIV, household contacts of patients with tuberculosis and other vulnerable population groups. The document incorporates new evidence on shorter rifamycin-containing preventive treatment regimens and updates previous WHO guidance to improve the clarity, consistency and global applicability of recommendations.\n\nDeveloped in accordance with WHO Guideline Review Committee requirements, the publication presents 18 evidence-based recommendations covering the identification of populations eligible for preventive treatment, exclusion of active tuberculosis, testing for latent tuberculosis infection, recommended preventive treatment regimens, monitoring and evaluation, and implementation considerations. Recommendations were formulated using the GRADE approach, taking into account the certainty of evidence, effectiveness, safety, values and preferences, equity, resource implications, acceptability and feasibility. The guideline is intended to support national policy-makers, programme managers and health-care providers in strengthening tuberculosis prevention and advancing implementation of the WHO End TB Strategy.",
      "dcterms:source": "catalogue/records/10665-331170.dc.json",
      "dcterms:hasVersion": "library/10665-331170"
    },
