[
  {
    "id": "10665-331170",
    "type": "book",
    "title": "WHO consolidated guidelines on tuberculosis: module 1: prevention: tuberculosis preventive treatment",
    "author": [
      {
        "literal": "World Health Organization"
      }
    ],
    "issued": {
      "date-parts": [
        [
          2020,
          2,
          25
        ]
      ]
    },
    "publisher": "World Health Organization",
    "ISBN": "9789240001503",
    "URL": "https://iris.who.int/handle/10665/331170",
    "language": "en",
    "abstract": "This guideline provides updated WHO recommendations for the programmatic management of tuberculosis preventive treatment (TPT) as part of the WHO consolidated guidelines on tuberculosis. It focuses on the prevention of active tuberculosis among people at increased risk of disease progression, particularly people living with HIV, household contacts of patients with tuberculosis and other vulnerable population groups. The document incorporates new evidence on shorter rifamycin-containing preventive treatment regimens and updates previous WHO guidance to improve the clarity, consistency and global applicability of recommendations.\n\nDeveloped in accordance with WHO Guideline Review Committee requirements, the publication presents 18 evidence-based recommendations covering the identification of populations eligible for preventive treatment, exclusion of active tuberculosis, testing for latent tuberculosis infection, recommended preventive treatment regimens, monitoring and evaluation, and implementation considerations. Recommendations were formulated using the GRADE approach, taking into account the certainty of evidence, effectiveness, safety, values and preferences, equity, resource implications, acceptability and feasibility. The guideline is intended to support national policy-makers, programme managers and health-care providers in strengthening tuberculosis prevention and advancing implementation of the WHO End TB Strategy."
  },
