  "@graph": [
    {
      "@id": "references/10665-357088",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "Guidelines for diagnosing, preventing and managing cryptococcal disease among adults, adolescents and children living with HIV",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2022-06-23",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240052178 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/357088",
      "dcterms:language": "en",
      "dcterms:abstract": "This guideline provides updated, evidence-informed recommendations for diagnosing, preventing and managing cryptococcal disease among adults, adolescents and children living with HIV. Developed in accordance with WHO Guideline Review Committee procedures, it replaces the 2018 guidance and incorporates important new evidence published in 2021 on the preferred antifungal induction regimen for cryptococcal meningitis. The recommendations are based on systematic reviews using the GRADE approach and are supported by considerations of acceptability, values and preferences, feasibility and cost–effectiveness. The document addresses cryptococcal disease as a major opportunistic infection contributing substantially to HIV-related illness, disability and mortality, particularly in low- and middle-income countries, and identifies priority knowledge gaps to inform future research.\n\nThe guideline recommends updated approaches to the diagnosis, prevention and treatment of cryptococcal disease, including revised guidance on induction therapy for cryptococcal meningitis, while maintaining earlier recommendations where evidence remains unchanged. It also outlines principles for implementation within a public health approach and is intended to support HIV programme managers, policy-makers, health-care professionals and people living with HIV in improving the prevention, early diagnosis and clinical management of cryptococcal disease.",
      "dcterms:source": "catalogue/records/10665-357088.dc.json",
      "dcterms:hasVersion": "library/10665-357088"
    },
