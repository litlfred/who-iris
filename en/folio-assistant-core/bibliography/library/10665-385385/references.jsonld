    {
      "@id": "references/10665-385385",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "Global hepatitis report 2026",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2026-04-24",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240122383 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/385385",
      "dcterms:language": "en",
      "dcterms:abstract": "This report provides a comprehensive assessment of the global burden of viral hepatitis and progress towards the goal of eliminating hepatitis as a public health threat by 2030. Drawing on data reported by Member States and modelled estimates, it analyses trends in incidence, prevalence and mortality associated with hepatitis B and C, covering the period from 2015 to 2024 based on the latest available data. It also situates these trends within the context of global commitments, strategies and targets.\n\nThe publication reviews the coverage and impact of key interventions for prevention, diagnosis and treatment, including vaccination, infection prevention and control, harm reduction and access to antiviral therapies. It identifies persistent gaps in testing and treatment, marked regional disparities, and the need for accelerated scale-up of services, particularly in high-burden settings. The report concludes that progress towards the 2030 elimination targets remains off track despite the availability of effective interventions. Intended for policymakers, programme managers and public health stakeholders, it serves as an analytical and strategic resource to guide national and global responses to viral hepatitis.",
      "dcterms:source": "catalogue/records/10665-385385.dc.json",
      "dcterms:hasVersion": "library/10665-385385"
    },
