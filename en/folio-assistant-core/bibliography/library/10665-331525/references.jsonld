    {
      "@id": "references/10665-331525",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "WHO operational handbook on tuberculosis: module 1: prevention: tuberculosis preventive treatment",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2020-03-23",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240002906",
      "dcterms:identifier": "https://iris.who.int/handle/10665/331525",
      "dcterms:language": "en",
      "dcterms:abstract": "This operational handbook provides practical guidance for the programmatic management and scale-up of tuberculosis preventive treatment (TPT) in line with WHO consolidated guidelines on tuberculosis. The publication addresses the global burden of tuberculosis infection and the need to expand preventive interventions among populations at high risk of developing TB disease, particularly people living with HIV, household contacts of TB patients and other vulnerable groups. It supports implementation of commitments made at the United Nations High-Level Meeting on Tuberculosis and outlines strategies to strengthen national responses through integrated, people-centred approaches.\n\nThe handbook describes the cascade of care for TPT, including identification of target populations, exclusion of active TB disease, testing for TB infection, treatment options, management of adverse events, adherence support, monitoring and evaluation, and ethical considerations. It also provides operational guidance for contact investigation, integration of preventive services with active TB case finding and HIV services, health system strengthening, and resource mobilization. Practical implementation tools, policy considerations and monitoring indicators are included to assist national TB programmes, policy-makers and health-care providers in adapting and scaling up TPT services in diverse epidemiological and health system settings.",
      "dcterms:source": "catalogue/records/10665-331525.dc.json",
      "dcterms:hasVersion": "library/10665-331525"
    },
