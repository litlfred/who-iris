  "@graph": [
    {
      "@id": "references/9789241549912-eng",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "WHO recommendations on antenatal care for a positive pregnancy experience",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2016-11-07",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789241549912",
      "dcterms:identifier": "https://iris.who.int/handle/10665/250796",
      "dcterms:language": "en",
      "dcterms:abstract": "This guideline presents the World Health Organization’s evidence-based recommendations on routine antenatal care to support a positive pregnancy experience for pregnant women and adolescent girls. It aims to provide a comprehensive, consolidated framework for antenatal care that complements existing WHO guidance on the management of specific pregnancy-related complications. The recommendations promote a person-centred, rights-based approach that extends beyond the prevention of maternal and perinatal morbidity and mortality to enhance women’s physical, psychological and sociocultural well-being, support healthy pregnancies, and improve the quality and utilization of antenatal care. Intended for policy-makers, programme managers and health professionals, the guideline informs the development of national policies, clinical protocols and service delivery models.\n\nDeveloped according to the WHO guideline development process, the document draws on systematic reviews and applies the GRADE and GRADE-CERQual approaches together with the DECIDE evidence-to-decision framework. It contains 49 recommendations covering nutritional interventions, maternal and fetal assessment, preventive measures, management of common physiological symptoms, and health system interventions to improve antenatal care utilization and quality. The guideline also introduces the 2016 WHO antenatal care model, recommending a minimum of eight contacts during pregnancy, and emphasizes implementation, dissemination and periodic updating as new evidence becomes available.",
      "dcterms:source": "catalogue/records/9789241549912-eng.dc.json",
      "dcterms:hasVersion": "library/9789241549912-eng"
    },
