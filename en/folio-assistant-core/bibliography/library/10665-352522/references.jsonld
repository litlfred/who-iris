  "@graph": [
    {
      "@id": "references/10665-352522",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "WHO consolidated guidelines on tuberculosis: module 5: management of tuberculosis in children and adolescents",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2022-03-18",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240046764 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/352522",
      "dcterms:language": "en",
      "dcterms:abstract": "Tuberculosis (TB) remains a major cause of morbidity and mortality among children and adolescents, with substantial gaps in case detection, diagnosis and access to preventive treatment worldwide. This guideline consolidates new and existing WHO recommendations for the management of TB in these populations, replacing the 2014 guidance and reflecting the latest evidence on prevention, screening, diagnosis, treatment and models of care. It aims to support countries in strengthening the continuum of TB care and improving health outcomes through evidence-based policies and practices tailored to the specific needs of children, adolescents and their families.\n\nThe publication provides recommendations on TB screening and contact investigation, TB preventive treatment, diagnostic approaches, treatment of drug-susceptible and drug-resistant TB, management of TB meningitis, and decentralized, family-centred models of care. It incorporates updated evidence on the use of Xpert MTB/RIF Ultra, integrated treatment decision algorithms, shortened treatment regimens for non-severe TB, and therapeutic options for multidrug- or rifampicin-resistant disease in children. Developed according to WHO guideline development standards, the document is intended for national TB programmes, policy-makers, health professionals and implementing partners, and contributes to global efforts to reduce TB-related morbidity and mortality in line with the End TB Strategy and Sustainable Development Goals.",
      "dcterms:source": "catalogue/records/10665-352522.dc.json",
      "dcterms:hasVersion": "library/10665-352522"
    },
