  "@graph": [
    {
      "@id": "references/10665-340255",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "WHO consolidated guidelines on tuberculosis: module 2: screening: systematic screening for tuberculosis disease",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2021-03-22",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240022676 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/340255",
      "dcterms:language": "en",
      "dcterms:abstract": "Tuberculosis remains one of the leading causes of death from a single infectious agent despite being largely preventable and curable. This updated WHO guideline provides evidence-based recommendations on systematic screening for tuberculosis disease to support earlier diagnosis, timely initiation of treatment and reduced transmission. It revises the 2013 guidance in light of new evidence on the effectiveness of screening interventions and the performance of screening tools, using the GRADE approach to assess the certainty of evidence and the strength of recommendations. The document is intended to assist countries in planning and implementing screening strategies adapted to their epidemiological and health system contexts.\n\nThe guideline presents recommendations for systematic screening in the general population and in groups at increased risk of tuberculosis, including people living with HIV, household contacts, prisoners, miners, migrants and other vulnerable populations. It also reviews the use of symptom screening, chest radiography, computer-aided detection software, C-reactive protein and molecular WHO-recommended rapid diagnostic tests as screening tools, together with guidance on monitoring, evaluation and implementation considerations. The publication identifies research gaps and is accompanied by an operational handbook providing practical guidance for applying the recommendations in national tuberculosis programmes.",
      "dcterms:source": "catalogue/records/10665-340255.dc.json",
      "dcterms:hasVersion": "library/10665-340255"
    },
