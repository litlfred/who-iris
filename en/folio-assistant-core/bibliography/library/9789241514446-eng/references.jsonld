    {
      "@id": "references/9789241514446-eng",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "National health workforce accounts: implementation guide",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2018-10-19",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789241514446",
      "dcterms:identifier": "https://iris.who.int/handle/10665/275473",
      "dcterms:language": "en",
      "dcterms:abstract": "The National Health Workforce Accounts (NHWA) Implementation Guide provides practical guidance for countries on establishing and sustaining systems to collect, analyse, use and report standardized health workforce data. Developed as a companion document to the NHWA Handbook and in support of the Global Strategy on Human Resources for Health: Workforce 2030, the guide outlines a structured approach to strengthening health workforce information systems and improving the availability, quality and use of human resources for health data. It is intended for policy-makers, programme managers, technical experts and stakeholders involved in health workforce planning, monitoring and governance, and emphasizes collaboration across sectors such as health, education, labour, finance and statistics.\n\nThe guide presents an implementation framework organized into three phases—conceptualization, operationalization, and scaling up and sustainability—comprising eight steps that address political commitment, governance arrangements, planning, legal considerations, data compilation and analysis, validation, dissemination, and process review. It describes the roles of national institutions and multistakeholder coordination mechanisms, provides guidance on data quality, reporting and communication processes, and promotes the integration of existing information systems. By supporting the systematic monitoring of health workforce indicators, the guide aims to strengthen evidence-informed decision-making and contribute to health workforce development, universal health coverage and broader national and global health objectives.",
      "dcterms:source": "catalogue/records/9789241514446-eng.dc.json",
      "dcterms:hasVersion": "library/9789241514446-eng"
    },
