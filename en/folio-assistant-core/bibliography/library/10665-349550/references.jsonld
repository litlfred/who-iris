  "@graph": [
    {
      "@id": "references/10665-349550",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "Global guidance on criteria and processes for validation: elimination of mother-to-child transmission of HIV, syphilis and hepatitis B virus",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2021-11-25",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240039360 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/349550",
      "dcterms:language": "en",
      "dcterms:abstract": "This guidance document provides updated World Health Organization criteria and processes for validating the elimination of mother-to-child transmission (EMTCT) of HIV, syphilis and hepatitis B virus (HBV) as public health priorities. Building on previous editions focused on HIV and syphilis, this third version incorporates validation guidance for HBV within the framework of the Triple Elimination Initiative. The document outlines standardized indicators, targets and assessment procedures for evaluating progress towards EMTCT across diverse epidemiological and programmatic settings. It addresses impact and process indicators, surveillance and laboratory quality standards, programme assessment, and requirements related to human rights, gender equality and community engagement.\n\nThe document emphasizes integrated maternal and child health approaches, universal access to quality antenatal and prevention services, and the importance of strong health systems and surveillance mechanisms. It also provides guidance for countries with high disease burdens through the Path to Elimination framework, as well as for countries with small numbers of affected pregnant women and special populations. Intended for national, regional and global validation bodies, the document supports harmonized validation processes while allowing countries to pursue single, dual or triple EMTCT validation according to national readiness and regional priorities.",
      "dcterms:source": "catalogue/records/10665-349550.dc.json",
      "dcterms:hasVersion": "library/10665-349550"
    },
