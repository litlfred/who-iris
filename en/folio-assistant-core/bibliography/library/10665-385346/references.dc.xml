    <dcterms:title xml:lang="en">Cost-effectiveness of introducing the pneumococcal conjugate vaccine for children under 5 years in the Islamic Republic of Iran</dcterms:title>
    <dcterms:creator>Khadijeh Ezoji</dcterms:creator>
    <dcterms:creator>Mohsen Yaghoubi</dcterms:creator>
    <dcterms:creator>Marzieh Nojomi</dcterms:creator>
    <dcterms:creator>Sussan Mahmoody</dcterms:creator>
    <dcterms:creator>Seyed Mohsen Zahraie</dcterms:creator>
    <dcterms:creator>Maziar Moradi-Lakeh</dcterms:creator>
    <dcterms:creator>Sedigheh R. Tabatabaei</dcterms:creator>
    <dcterms:creator>Abdollah Karimi</dcterms:creator>
    <dcterms:issued xsi:type="dcterms:W3CDTF">2019-10-29</dcterms:issued>
    <dcterms:publisher>World Health Organization. Regional Office for the Eastern Mediterranean</dcterms:publisher>
