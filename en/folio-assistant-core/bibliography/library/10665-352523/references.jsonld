  "@graph": [
    {
      "@id": "references/10665-352523",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "WHO operational handbook on tuberculosis: module 5: management of tuberculosis in children and adolescents",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2022-03-18",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240046832 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/352523",
      "dcterms:language": "en",
      "dcterms:abstract": "This operational handbook provides practical guidance for implementing World Health Organization recommendations on the prevention, screening, diagnosis and management of tuberculosis (TB) in children and adolescents under programmatic conditions and across different levels of the health system. Developed alongside the WHO consolidated guidelines on tuberculosis, the publication addresses the specific epidemiological, clinical and psychosocial vulnerabilities of children and adolescents affected by TB, including challenges related to diagnosis, treatment adherence, prevention and continuity of care. The handbook aims to support the development and revision of national policies, operational guidance and service delivery approaches tailored to the needs of these populations.\n\nThe handbook covers the full continuum of TB care, including contact investigation, systematic screening, preventive treatment, diagnostic approaches for pulmonary and extrapulmonary TB, and treatment of drug-susceptible and drug-resistant disease. It also addresses decentralized and family-centred models of care, management of TB in children and adolescents living with HIV, TB during pregnancy, malnutrition, pneumonia, adolescent health needs and palliative care. Practical tools, implementation guidance and standard operating procedures are included to support programme managers and health-care providers in strengthening child and adolescent TB services.",
      "dcterms:source": "catalogue/records/10665-352523.dc.json",
      "dcterms:hasVersion": "library/10665-352523"
    },
