    {
      "@id": "references/10665-340190",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "Guidelines: updated recommendations on HIV prevention, infant diagnosis, antiretroviral initiation and monitoring",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2021-03-17",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240022232 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/340190",
      "dcterms:language": "en",
      "dcterms:abstract": "This guideline presents updated WHO recommendations on selected priority areas across the HIV prevention, diagnosis and treatment continuum, developed in response to emerging evidence, implementation experience and evolving clinical practice. Prepared according to WHO Guideline Review Committee procedures and informed by systematic reviews using the GRADE approach, it updates and complements the 2016 consolidated HIV guidelines. The publication addresses key public health challenges affecting the global HIV response, particularly in resource-limited settings, and supports progress towards ending AIDS as a public health threat by 2030 through a public health approach to service delivery.\n\nThe guideline introduces or updates recommendations on the use of the dapivirine vaginal ring as an additional HIV prevention option for women at substantial risk of infection, point-of-care technologies for infant HIV diagnosis and viral load monitoring, revised treatment monitoring algorithms, and earlier initiation of antiretroviral therapy for people living with HIV and tuberculosis. It also provides updated clinical considerations for rapid antiretroviral therapy initiation and outlines implementation principles to support national adaptation. Intended for policy-makers, programme managers, clinicians and implementing partners, the guideline aims to strengthen evidence-based HIV prevention, diagnosis, treatment monitoring and care across diverse settings.",
      "dcterms:source": "catalogue/records/10665-340190.dc.json",
      "dcterms:hasVersion": "library/10665-340190"
    },
