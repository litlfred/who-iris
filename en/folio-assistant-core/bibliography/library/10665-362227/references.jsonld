  "@graph": [
    {
      "@id": "references/10665-362227",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "WHO implementation tool for pre-exposure prophylaxis (PrEP) of HIV infection: module 13: integrating STI services",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2022-09-05",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240057425 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/362227",
      "dcterms:language": "en",
      "dcterms:abstract": "This module of the WHO Implementation Tool for Pre-Exposure Prophylaxis (PrEP) of HIV Infection provides operational guidance on integrating sexually transmitted infection (STI) services into HIV PrEP programmes. Developed for programme managers, decision-makers, facility managers and health-care workers, it compiles existing WHO recommendations and evidence to support the planning, implementation and scale-up of integrated, people-centred sexual health services. The document outlines the epidemiology and burden of STIs, particularly among populations who may benefit from or use PrEP, and highlights the public health rationale for strengthening STI prevention, testing, treatment and follow-up within PrEP delivery platforms.\n\nThe module describes practical approaches to integrating STI services across different service delivery models, including considerations related to workforce capacity, task sharing, monitoring, financing and demand generation. It presents guidance on counselling, health promotion, screening, diagnostic testing, partner services, clinical management, referral pathways and prevention measures such as condom provision and vaccination. Emphasizing differentiated service delivery and human rights principles, the publication aims to improve access to comprehensive sexual health care, enhance service quality and support efforts to reduce the burden of HIV and other sexually transmitted infections through coordinated and efficient health-system responses.",
      "dcterms:source": "catalogue/records/10665-362227.dc.json",
      "dcterms:hasVersion": "library/10665-362227"
    },
