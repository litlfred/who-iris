[
  {
    "id": "9789240093362-eng",
    "type": "book",
    "title": "Digital transformation handbook for primary health care: optimizing person-centred point of service systems",
    "author": [
      {
        "literal": "World Health Organization"
      }
    ],
    "issued": {
      "date-parts": [
        [
          2024,
          11,
          4
        ]
      ]
    },
    "publisher": "World Health Organization",
    "ISBN": "9789240093362 (electronic version)",
    "URL": "https://iris.who.int/handle/10665/379452",
    "language": "en",
    "abstract": "This handbook provides practical guidance for countries seeking to digitally transform primary health care through the development and implementation of person-centred point of service systems (PCPOSS). It addresses the transition from paper-based and fragmented digital systems towards integrated, interoperable digital solutions that support service delivery, continuity of care, data use and health system strengthening. Grounded in WHO recommendations on digital interventions for health system strengthening and aligned with the SMART Guidelines framework, the publication outlines approaches for translating clinical and public health guidance into digital systems while maintaining fidelity to normative standards.\n\nThe publication presents a stepwise methodology covering assessment of digital readiness, identification of user requirements, workflow and business process mapping, system design and adaptation, software selection, testing, deployment and scale-up. It emphasizes person-centred care, interoperability, longitudinal health records, decision support and the use of standards-based digital architectures. Through practical tools, worksheets and implementation guidance, the publication supports policy-makers, programme managers, digital health practitioners and software developers in designing and optimizing digital systems that improve service quality, strengthen accountability and enable more effective, integrated and responsive primary health care services."
  },
