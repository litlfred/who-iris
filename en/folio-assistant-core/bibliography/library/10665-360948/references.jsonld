  "@graph": [
    {
      "@id": "references/10665-360948",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "Consolidated guidelines on person-centred HIV strategic information: strengthening routine data for impact",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2022-07-28",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240055315 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/360948",
      "dcterms:language": "en",
      "dcterms:abstract": "These consolidated guidelines provide normative guidance for strengthening HIV strategic information through person-centred routine data systems that support both clinical care and programme management. Developed in response to persistent gaps in HIV prevention, testing, treatment and retention despite substantial progress in the global HIV response, the guidelines promote the collection and use of individual-level longitudinal data to improve continuity of care, strengthen linkage across services and enhance monitoring of programme performance. They consolidate and update previous WHO guidance while introducing recommendations on person-centred monitoring, digital health information systems, interoperability, data quality, surveillance and the integration of HIV services with tuberculosis, viral hepatitis, sexually transmitted infections and other related conditions.\n\nThe publication outlines recommendations and operational guidance on HIV prevention monitoring, patient monitoring, surveillance, digital health data, routine data use, priority indicators and implementation considerations. It emphasizes the transition from aggregate reporting to person-centred, digital information systems that support clinical decision-making, programme improvement and public health action while ensuring data privacy, confidentiality and security. The guidelines also describe minimum datasets, standardized monitoring tools and approaches to improving data quality and using routine information to strengthen service delivery and measure progress towards global HIV targets.",
      "dcterms:source": "catalogue/records/10665-360948.dc.json",
      "dcterms:hasVersion": "library/10665-360948"
    },
