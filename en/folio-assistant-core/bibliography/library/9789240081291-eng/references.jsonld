    {
      "@id": "references/9789240081291-eng",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "National health workforce accounts: a handbook",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2023-11-23",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240081291 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/374320",
      "dcterms:language": "en",
      "dcterms:abstract": "The National Health Workforce Accounts (NHWA) Handbook, second edition, provides the conceptual framework, standards, methods and indicators that support the systematic collection, analysis and use of health workforce data for evidence-informed policy-making and planning. Developed by the World Health Organization, the handbook supports implementation of the National Health Workforce Accounts as a country-led system to strengthen human resources for health information systems, improve data quality and availability, and monitor progress towards universal health coverage, the Sustainable Development Goals and other global health objectives. It describes the rationale, principles and applications of NHWA at national, regional and global levels and outlines a modular approach to health workforce monitoring.\n\nThe handbook presents guidance on implementation and reporting methods and defines a set of standardized indicators organized into four modules covering workforce stock and flows, education, finance and expenditures, and working conditions, governance and leadership. It explains indicator metadata, calculation methods, disaggregation requirements and reporting standards, and illustrates how NHWA data can be used to support workforce planning, policy development, retention strategies, equity analyses and monitoring of health workforce trends. The revised edition incorporates updated indicators, occupational classifications, tools and guidance to address evolving health workforce priorities and emerging global health challenges.",
      "dcterms:source": "catalogue/records/9789240081291-eng.dc.json",
      "dcterms:hasVersion": "library/9789240081291-eng"
    },
